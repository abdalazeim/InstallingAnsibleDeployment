#!/bin/bash
# Managed by Ansible - Restore from backup
BACKUP_DIR="{{ backup_dir | default('/var/backups') }}"
RESTORE_DIR="/tmp/restore-$$"

if [ $# -eq 0 ]; then
    echo "Usage: $0 <backup-file>"
    echo "Available backups:"
    ls -1 "${BACKUP_DIR}"/backup-*.tar.gz 2>/dev/null
    exit 1
fi

BACKUP_FILE="$1"
if [ ! -f "${BACKUP_FILE}" ]; then
    BACKUP_FILE="${BACKUP_DIR}/${BACKUP_FILE}"
fi

if [ ! -f "${BACKUP_FILE}" ]; then
    echo "Error: Backup file not found: ${BACKUP_FILE}"
    exit 1
fi

echo "Starting restore from: ${BACKUP_FILE}"
echo "Restore started at: $(date)"

# Create temporary directory
mkdir -p "${RESTORE_DIR}"

# Extract backup
tar -xzf "${BACKUP_FILE}" -C "${RESTORE_DIR}"

# Restore system configuration
echo "Restoring /etc..."
cp -rf "${RESTORE_DIR}/etc/"* /etc/ 2>/dev/null || true

# Restore /opt
echo "Restoring /opt..."
cp -rf "${RESTORE_DIR}/opt/"* /opt/ 2>/dev/null || true

# Restore /var/lib
echo "Restoring /var/lib..."
cp -rf "${RESTORE_DIR}/var/lib/"* /var/lib/ 2>/dev/null || true

# Cleanup
rm -rf "${RESTORE_DIR}"

echo "Restore completed at: $(date)"
exit 0