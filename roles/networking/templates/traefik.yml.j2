entryPoints:
  web:
    address: ":80"
  websecure:
    address: ":443"
providers:
  file:
    filename: /etc/traefik/dynamic.yml
    watch: true
{% if traefik_docker_endpoint | default('') %}
  docker:
    endpoint: {{ traefik_docker_endpoint | to_json }}
    exposedByDefault: false
{% endif %}
api:
  dashboard: false
ping: {}
certificatesResolvers:
  letsencrypt:
    acme:
      email: {{ traefik_acme_email | to_json }}
      storage: /acme.json
      httpChallenge:
        entryPoint: web
