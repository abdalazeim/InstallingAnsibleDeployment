[Unit]
Description=Gunicorn service for {{ django_project_name | default("myproject") }}
After=network.target

[Service]
User={{ django_gunicorn_user | default("django") }}
Group={{ django_gunicorn_group | default("django") }}
WorkingDirectory={{ django_app_dir | default("/opt/django_app") }}
EnvironmentFile={{ django_app_dir | default("/opt/django_app") }}/.env
ExecStart={{ django_venv_dir | default("/opt/django_venv") }}/bin/gunicorn \
  --workers {{ django_gunicorn_workers | default(4) }} \
  --timeout 30 \
  --keep-alive 2 \
  --bind 127.0.0.1:{{ django_gunicorn_port | default(8000) }} \
  --access-logfile /var/log/gunicorn/access.log \
  --error-logfile /var/log/gunicorn/error.log \
  --log-level info \
  {{ django_project_name | default("myproject") }}.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target