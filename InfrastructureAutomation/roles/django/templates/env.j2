# Managed by Ansible - Django Environment
DEBUG={{ django_debug | default(False) }}
SECRET_KEY={{ django_secret_key | default('change-me-in-production') }}
ALLOWED_HOSTS={{ django_allowed_hosts | default(['*']) | join(',') }}
DATABASE_URL=postgres://{{ django_db_user | default('postgres') }}:{{ django_db_password | default('postgres') }}@{{ django_db_host | default('localhost') }}:{{ django_db_port | default('5432') }}/{{ django_db_name | default('myproject') }}
REDIS_URL={{ django_redis_url | default('redis://localhost:6379/0') }}
EMAIL_HOST={{ django_email_host | default('localhost') }}
EMAIL_PORT={{ django_email_port | default(25) }}
EMAIL_HOST_USER={{ django_email_user | default('') }}
EMAIL_HOST_PASSWORD={{ django_email_password | default('') }}
DEFAULT_FROM_EMAIL={{ django_default_from_email | default('noreply@example.com') }}
SERVER_NAME={{ django_server_name | default('localhost') }}